  <!-- Scrollspy Script for Floating Navigation Scroll Sync -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const sections = [
        document.getElementById('generator-section'),
        document.getElementById('how-to-use'),
        document.getElementById('what-is-cron'),
        document.getElementById('cron-fields'),
        document.getElementById('scheduler-matrix'),
        document.getElementById('production-hardening'),
        document.getElementById('common-examples'),
        document.getElementById('faq-section')
      ].filter(Boolean);
      
      const navLinks = document.querySelectorAll('.floating-nav-link');

      let isScrollingFromClick = false;
      let clickTimeout = null;

      navLinks.forEach(link => {
        link.addEventListener('click', () => {
          isScrollingFromClick = true;
          if (clickTimeout) clearTimeout(clickTimeout);
          
          navLinks.forEach(l => {
            if (l === link) {
              l.classList.remove('text-mute');
              l.classList.add('text-white', 'bg-hairline-strong/75', 'border', 'border-hairline-strong');
            } else {
              l.classList.remove('text-white', 'bg-hairline-strong/75', 'border', 'border-hairline-strong');
              l.classList.add('text-mute');
            }
          });

          clickTimeout = setTimeout(() => {
            isScrollingFromClick = false;
          }, 800);
        });
      });

      function updateActiveSectionOnScroll() {
        if (isScrollingFromClick) return;

        let activeSection = null;
        let minDistance = Infinity;

        sections.forEach(sec => {
          const rect = sec.getBoundingClientRect();
          const distance = Math.abs(rect.top - 150);
          
          if (rect.top < window.innerHeight * 0.45 && rect.bottom > 150) {
            if (distance < minDistance) {
              minDistance = distance;
              activeSection = sec;
            }
          }
        });

        if (activeSection) {
          const id = activeSection.getAttribute('id');
          navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (href === `#${id}`) {
              link.classList.remove('text-mute');
              link.classList.add('text-white', 'bg-hairline-strong/75', 'border', 'border-hairline-strong');
            } else {
              link.classList.remove('text-white', 'bg-hairline-strong/75', 'border', 'border-hairline-strong');
              link.classList.add('text-mute');
            }
          });
        }
      }

      let scrollTicking = false;
      window.addEventListener('scroll', () => {
        if (!scrollTicking) {
          window.requestAnimationFrame(() => {
            updateActiveSectionOnScroll();
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      }, { passive: true });

      updateActiveSectionOnScroll();
    });
  </script>

  <style>
    .nav-tooltip {
      position: absolute;
      z-index: 50;
      pointer-events: none;
      opacity: 0;
      display: none;
      white-space: nowrap;
      transition: transform 0.12s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.12s ease;
    }

    @media (min-width: 768px) {
      .nav-tooltip {
        display: block;
        bottom: 100%;
        left: 50%;
        transform: translate(-50%, 6px) scale(0.95);
        transform-origin: bottom center;
      }
      .floating-nav-link:hover .nav-tooltip,
      .floating-nav-link:focus-within .nav-tooltip {
        opacity: 1;
        transform: translate(-50%, -2px) scale(1);
      }
    }

    @media (min-width: 1024px) {
      .nav-tooltip {
        bottom: auto;
        left: auto;
        top: 50%;
        right: 100%;
        transform: translate(6px, -50%) scale(0.95);
        transform-origin: right center;
      }
      .floating-nav-link:hover .nav-tooltip,
      .floating-nav-link:focus-within .nav-tooltip {
        opacity: 1;
        transform: translate(-2px, -50%) scale(1);
      }
    }
  </style>
