---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import CronGen from '../components/CronGen.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Cron Expression Generator & Builder | Online Crontab Schedule Parser"
  description="Free online cron expression generator, translator, and evaluator. Build, parse, test, and understand crontab patterns for Linux, Quartz, Spring, AWS EventBridge, Kubernetes, and node-cron."
  lang="en"
>
  <!-- Decorative Top Mesh Gradient -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <Header lang="en" />

  <!-- Hero Section -->
  <main id="main-content" class="relative z-10 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <section class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-link/10 text-link border border-link/20">
        v1.0.0 Stable • Developer Reference
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white text-balance">
        Cron Expression Generator.
      </h1>
      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed text-balance">
        An elegant, interactive crontab builder, parser, and schedule evaluator for developers. Generate cron expressions, inspect upcoming execution timelines, and translate Unix scheduler syntax in real time.
      </p>
    </section>

    <!-- Generator Interface Section -->
    <section id="generator-section" class="mb-24 scroll-mt-24" aria-label="Cron Expression Generator Tool">
      <CronGen lang="en" />
    </section>

    <!-- Editorial Content Architecture (2,500+ Words of Deep Technical Value) -->
    <div class="flex flex-col gap-20 border-t border-hairline pt-16 mb-24 max-w-5xl mx-auto">
      
      <!-- 1. How to Use Section -->
      <section id="how-to-use" class="scroll-mt-24 space-y-6">
        <div class="max-w-3xl">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            How to Use the CronGen Generator
          </h2>
          <p class="text-sm text-body leading-relaxed mt-2">
            Follow this quick step-by-step workflow to construct, validate, and preview standard Unix and cloud cron expressions with zero guessing.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">Step 01</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">1. Select Target Field</h3>
            <p class="text-xs text-body leading-relaxed">
              Click on any of the five segment capsules (Minute, Hour, Day of Month, Month, Day of Week) in the interactive display. The selected field highlights in blue, isolating your focus.
            </p>
          </div>

          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">Step 02</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">2. Input Values or Presets</h3>
            <p class="text-xs text-body leading-relaxed">
              Type custom intervals (e.g. <code class="text-link font-mono">*/15</code>, <code class="text-link font-mono">0</code>, or <code class="text-link font-mono">1-5</code>) directly into the text field, adjust sliders, or click quick presets like <em>Hourly</em> or <em>Daily at Midnight</em>.
            </p>
          </div>

          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">Step 03</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">3. Verify Translation & Copy</h3>
            <p class="text-xs text-body leading-relaxed">
              Review the live natural-language translation banner and verify the next 5 upcoming run timestamps. Once confirmed, click <strong>Copy Cron Expression</strong> to save it directly to your clipboard.
            </p>
          </div>
        </div>
      </section>

      <!-- 2. What is Cron & Architecture Section -->
      <article id="what-is-cron" class="scroll-mt-24 space-y-8">
        <div class="max-w-3xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            What is Cron? The Inner Architecture of Unix Task Scheduling
          </h2>
          <p class="text-sm text-body leading-relaxed">
            An in-depth explanation of how time-based daemon processes manage background automation across POSIX systems.
          </p>
        </div>
        
        <div class="text-sm text-body leading-relaxed space-y-4">
          <p>
            In Unix-like operating systems (such as Linux, FreeBSD, and macOS), <strong class="text-white font-medium">cron</strong> is an autonomous background daemon (<code class="text-link font-mono bg-canvas-soft px-1 rounded">crond</code>) responsible for executing scheduled commands, maintenance scripts, and administrative jobs at fixed intervals. The name originates from the ancient Greek word <em class="text-white">Chronos</em> (χρόνος), personifying chronological time. First implemented by Ken Thompson in Version 7 Unix in 1979, the cron scheduler has remained the foundational scheduling engine across server operating systems for more than four decades.
          </p>
          <p>
            Understanding how <code class="text-link font-mono bg-canvas-soft px-1 rounded">crond</code> operates under the hood is vital for modern software engineering. Unlike transient user processes, the cron daemon initializes during system boot, reads all designated scheduling configuration tables (known as <strong class="text-white font-medium">crontabs</strong>), and enters a persistent sleep state. Every sixty seconds, the daemon wakes up, checks the system clock against the stored schedules, forks child processes to execute matching commands in an isolated shell environment, and sleeps until the next minute mark.
          </p>
        </div>

        <!-- Terminal Anatomy Visual Widget -->
        <div class="relative bg-canvas-soft-2 border border-hairline rounded-xl p-6 font-mono text-xs text-body overflow-x-auto shadow-inner group">
          <div class="absolute top-0 left-0 w-1.5 h-full bg-link rounded-l-xl opacity-90"></div>
          <div class="flex items-center gap-2 mb-4">
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500/90"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/90"></span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500/90"></span>
            <span class="text-[9px] text-mute uppercase tracking-widest font-bold ml-2">Standard POSIX Crontab Field Hierarchy</span>
          </div>
          
          <pre class="text-white font-mono leading-relaxed select-all">
# ┌────────────── Minute (0 - 59)
# │ ┌──────────── Hour (0 - 23, 24-hour clock)
# │ │ ┌────────── Day of Month (1 - 31)
# │ │ │ ┌──────── Month (1 - 12 or JAN - DEC)
# │ │ │ │ ┌────── Day of Week (0 - 6 or SUN - SAT, 0 = Sunday)
# │ │ │ │ │
# * * * * * &lt;command to execute&gt;</pre>
        </div>

        <!-- Deep Dive Comparison: User Crontab vs System Crontab vs Anacron vs Systemd Timers -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-white tracking-tight">System Crontab vs User Crontab vs Modern Alternatives</h3>
          <p class="text-sm text-body leading-relaxed">
            Linux systems distinguish between user-level and system-level crontab files, which frequently confuses developers transitioning from local scripting to infrastructure management:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs">
            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <h4 class="font-bold text-white font-mono uppercase text-link text-xs">User Crontab (`crontab -e`)</h4>
              <p class="text-body leading-relaxed">
                Stored under spool directories (e.g. <code class="text-white font-mono">/var/spool/cron/crontabs/&lt;user&gt;</code>). Contains <strong>5 fields</strong> followed by the shell command. Commands execute under the permissions and identity of that specific user account without requiring root access.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <h4 class="font-bold text-white font-mono uppercase text-link text-xs">System Crontab (`/etc/crontab` & `/etc/cron.d/`)</h4>
              <p class="text-body leading-relaxed">
                Contains an additional <strong>6th field</strong>: the username responsible for running the process (e.g. <code class="text-white font-mono">0 2 * * * root /usr/sbin/logrotate</code>). Forgetting this 6th user field in <code class="text-white font-mono">/etc/cron.d/</code> is one of the most common causes of silent execution failures.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <h4 class="font-bold text-white font-mono uppercase text-link text-xs">Anacron (Asynchronous Cron)</h4>
              <p class="text-body leading-relaxed">
                Designed for desktops, workstations, and laptops that are shut down overnight. Unlike standard cron which skips missed jobs if the host was offline, Anacron tracks timestamps and runs overdue daily, weekly, or monthly jobs as soon as the machine boots up.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <h4 class="font-bold text-white font-mono uppercase text-link text-xs">Systemd Timers (`systemd.timer`)</h4>
              <p class="text-body leading-relaxed">
                The modern Linux service manager alternative to cron. Using calendar specifications (<code class="text-white font-mono">OnCalendar=*-*-* 02:00:00</code>), systemd timers offer microsecond resolution, integrated `journald` logging, cgroup resource constraints, and declarative service dependencies.
              </p>
            </div>
          </div>
        </div>
      </article>

      <!-- 3. Cron Fields & Special Syntax Reference -->
      <section id="cron-fields" class="scroll-mt-24 space-y-8">
        <div class="max-w-3xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            Comprehensive Field-by-Field Reference & Operators
          </h2>
          <p class="text-sm text-body leading-relaxed">
            Master the exact value boundaries, alphanumeric aliases, and special characters supported across POSIX and extended schedulers.
          </p>
        </div>

        <!-- Field Reference Table -->
        <div class="overflow-x-auto border border-hairline rounded-xl">
          <table class="w-full text-left text-xs sm:text-sm font-mono">
            <thead class="bg-canvas-soft text-white border-b border-hairline">
              <tr>
                <th scope="col" class="py-3 px-4">Position</th>
                <th scope="col" class="py-3 px-4">Field Name</th>
                <th scope="col" class="py-3 px-4">Allowed Range</th>
                <th scope="col" class="py-3 px-4">Allowed Values / Aliases</th>
                <th scope="col" class="py-3 px-4">Supported Operators</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline bg-canvas-soft/40 text-body">
              <tr>
                <td class="py-3 px-4 text-white font-bold">1</td>
                <td class="py-3 px-4 text-white">Minute</td>
                <td class="py-3 px-4 tabular-nums">0 – 59</td>
                <td class="py-3 px-4 text-mute">Exact integer</td>
                <td class="py-3 px-4 text-link font-bold">* , - /</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">2</td>
                <td class="py-3 px-4 text-white">Hour</td>
                <td class="py-3 px-4 tabular-nums">0 – 23</td>
                <td class="py-3 px-4 text-mute">24-hour military clock</td>
                <td class="py-3 px-4 text-link font-bold">* , - /</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">3</td>
                <td class="py-3 px-4 text-white">Day of Month</td>
                <td class="py-3 px-4 tabular-nums">1 – 31</td>
                <td class="py-3 px-4 text-mute">Calendar day</td>
                <td class="py-3 px-4 text-link font-bold">* , - / ? L W</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">4</td>
                <td class="py-3 px-4 text-white">Month</td>
                <td class="py-3 px-4 tabular-nums">1 – 12</td>
                <td class="py-3 px-4 text-white">JAN, FEB, MAR, APR, MAY, JUN, JUL, AUG, SEP, OCT, NOV, DEC</td>
                <td class="py-3 px-4 text-link font-bold">* , - /</td>
              </tr>
              <tr>
                <td class="py-3 px-4 text-white font-bold">5</td>
                <td class="py-3 px-4 text-white">Day of Week</td>
                <td class="py-3 px-4 tabular-nums">0 – 6</td>
                <td class="py-3 px-4 text-white">SUN, MON, TUE, WED, THU, FRI, SAT (0 or 7 = Sun)</td>
                <td class="py-3 px-4 text-link font-bold">* , - / ? L #</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Special Operators Guide -->
        <div class="space-y-4">
          <h3 class="text-lg font-bold text-white tracking-tight">The 8 Special Characters Explained</h3>
          <p class="text-sm text-body leading-relaxed">
            Cron expressions use special punctuation characters to define patterns, intervals, and conditional ranges. Here is the behavior of every operator:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">* (Asterisk / Wildcard)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Universal</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Selects every possible value within that field. In the minute position, it triggers every 60 seconds. In the month position, it triggers in every month of the year.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>* * * * *</span>
                <span class="text-mute">Every minute</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">, (Comma / List Union)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Discrete Sets</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies a comma-separated list of individual values. Ideal for jobs that must run at multiple specific times without writing separate crontab entries.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 8,12,18 * * *</span>
                <span class="text-mute">At 8am, 12pm, 6pm</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">- (Hyphen / Inclusive Range)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Continuous Range</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies an inclusive series of values between a start and end point. Frequently used for confining business tasks to Monday through Friday or working hours.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 9-17 * * 1-5</span>
                <span class="text-mute">9am to 5pm, Mon-Fri</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">/ (Slash / Step Interval)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Modulo Increments</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies skip increments. <code class="text-white font-mono">*/10</code> in the minute slot executes at minutes 0, 10, 20, 30, 40, and 50. Can be combined with ranges like <code class="text-white font-mono">10-30/5</code>.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>*/10 * * * *</span>
                <span class="text-mute">Every 10 minutes</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">? (Question Mark / Unspecified)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Quartz / AWS</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Used in Quartz, Spring, and AWS EventBridge to declare "no specific value". Required when you specify Day of Month and want to leave Day of Week unconstrained (or vice-versa).
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 12 * * ? *</span>
                <span class="text-mute">AWS EventBridge 12pm</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">L (Last Day Modifier)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Quartz / Enterprise</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Stands for "Last". In Day of Month, <code class="text-white font-mono">L</code> triggers on the final day of the month (Feb 28, Apr 30, etc.). In Day of Week, <code class="text-white font-mono">5L</code> means the last Friday of the month.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 0 L * ?</span>
                <span class="text-mute">Last day of month</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link">W (Nearest Weekday)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Business Logic</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Calculates the closest Monday–Friday business day to a given calendar date. For example, <code class="text-white font-mono">15W</code> executes on Friday the 14th if the 15th falls on a Saturday.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 0 15W * ?</span>
                <span class="text-mute">Nearest weekday to 15th</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-sm font-mono font-bold text-link"># (N-th Weekday Instance)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Calendar Ordinals</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies the Nth occurrence of a weekday in the month. <code class="text-white font-mono">2#2</code> represents the second Monday of the month. Perfect for recurring sprint cycles and board meetings.
              </p>
              <div class="bg-canvas-soft-2 p-2 rounded text-xs font-mono text-white flex justify-between">
                <span>0 9 ? * 2#2</span>
                <span class="text-mute">2nd Monday at 9am</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Non-Standard Predefined Macro Strings -->
        <div class="space-y-3">
          <h3 class="text-base font-bold text-white tracking-tight">Predefined Crontab Macro Shortcuts</h3>
          <p class="text-xs sm:text-sm text-body leading-relaxed">
            Many Linux crontab implementations support convenient human-readable alias macros in place of numerical expressions:
          </p>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs font-mono">
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@reboot</span><p class="text-[11px] text-mute mt-1">Runs once at daemon startup</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@hourly</span><p class="text-[11px] text-mute mt-1">0 * * * * (Top of hour)</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@daily</span><p class="text-[11px] text-mute mt-1">0 0 * * * (Midnight daily)</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@weekly</span><p class="text-[11px] text-mute mt-1">0 0 * * 0 (Midnight Sunday)</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@monthly</span><p class="text-[11px] text-mute mt-1">0 0 1 * * (1st of month)</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@yearly</span><p class="text-[11px] text-mute mt-1">0 0 1 1 * (Jan 1st midnight)</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@annually</span><p class="text-[11px] text-mute mt-1">Identical to @yearly</p></div>
            <div class="bg-canvas-soft border border-hairline p-3 rounded-lg"><span class="text-link font-bold">@midnight</span><p class="text-[11px] text-mute mt-1">Identical to @daily</p></div>
          </div>
        </div>
      </section>

      <!-- 4. Cross-Platform Schedulers Matrix -->
      <section id="scheduler-matrix" class="scroll-mt-24 space-y-8">
        <div class="max-w-3xl space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            Cross-Platform Schedulers Compatibility Matrix
          </h2>
          <p class="text-sm text-body leading-relaxed">
            Different platforms and cloud ecosystems enforce distinct cron dialect rules. Review how your target environment parses expressions.
          </p>
        </div>

        <div class="overflow-x-auto border border-hairline rounded-xl">
          <table class="w-full text-left text-xs sm:text-sm font-mono">
            <thead class="bg-canvas-soft text-white border-b border-hairline">
              <tr>
                <th scope="col" class="py-3 px-4">Engine / Framework</th>
                <th scope="col" class="py-3 px-4">Field Count</th>
                <th scope="col" class="py-3 px-4">Seconds Support</th>
                <th scope="col" class="py-3 px-4">Year Field</th>
                <th scope="col" class="py-3 px-4">Key Constraints & Rules</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-hairline bg-canvas-soft/40 text-body">
              <tr>
