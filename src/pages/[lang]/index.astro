---
import Layout from '../../layouts/Layout.astro';
import CronGen from '../../components/CronGen.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SUPPORTED_LOCALES, useTranslations, type SupportedLocale } from '../../i18n/utils';

export function getStaticPaths() {
  return SUPPORTED_LOCALES.filter(l => l.code !== 'en').map(l => ({
    params: { lang: l.code },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = useTranslations(lang);
---

<Layout 
  title={t('meta.homeTitle')}
  description={t('meta.homeDesc')}
  lang={lang}
>
  <!-- Decorative Top Mesh Gradient -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <Header lang={lang} />

  <!-- Hero Section -->
  <main id="main-content" class="relative z-10 max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
    <section class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-link/10 text-link border border-link/20">
        {t('hero.badge')}
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white text-balance">
        {t('hero.title')}
      </h1>
      <p class="text-base sm:text-lg text-body max-w-2xl mx-auto leading-relaxed text-balance">
        {t('hero.subtitle')}
      </p>
    </section>

    <!-- Generator Interface Section -->
    <section id="generator-section" class="mb-24 scroll-mt-24" aria-label="Cron Expression Generator Tool">
      <CronGen lang={lang} />
    </section>

    <!-- Content Layout: How to Use & What is Cron -->
    <div class="flex flex-col gap-16 border-t border-hairline pt-16 mb-24">
      
      <!-- Section: How to Use -->
      <section id="how-to-use" class="scroll-mt-24 space-y-6">
        <div class="max-w-2xl">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            {t('how.title')}
          </h2>
          <p class="text-sm text-body leading-relaxed mt-2">
            {t('how.subtitle')}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Step 1 Card -->
          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">{t('how.step1Tag')}</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">{t('how.step1Title')}</h3>
            <p class="text-xs text-body leading-relaxed">
              {t('how.step1Desc')}
            </p>
          </div>

          <!-- Step 2 Card -->
          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">{t('how.step2Tag')}</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">{t('how.step2Title')}</h3>
            <p class="text-xs text-body leading-relaxed">
              {t('how.step2Desc')}
            </p>
          </div>

          <!-- Step 3 Card -->
          <div class="relative bg-canvas-soft-2 border border-hairline hover:border-link/30 rounded-xl p-5 shadow-lg transition duration-200 group">
            <div class="absolute -top-3 left-4 bg-link/10 text-link border border-link/20 text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded shadow">{t('how.step3Tag')}</div>
            <h3 class="text-xs font-semibold text-white tracking-tight mt-2 mb-2 font-mono">{t('how.step3Title')}</h3>
            <p class="text-xs text-body leading-relaxed">
              {t('how.step3Desc')}
            </p>
          </div>
        </div>
      </section>

      <!-- Section: What is a Cron Expression? -->
      <article id="what-is-cron" class="scroll-mt-24 space-y-6">
        <div class="max-w-2xl">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            {t('what.title')}
          </h2>
        </div>
        
        <div class="text-sm text-body leading-relaxed space-y-4">
          <p>{t('what.p1')}</p>
          <p>{t('what.p2')}</p>
        </div>

        <!-- Terminal Anatomy Widget -->
        <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-5 sm:p-6 shadow-xl space-y-4">
          <h3 class="text-sm font-bold text-white font-mono flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            {t('anatomy.title')}
          </h3>
          <p class="text-xs text-mute leading-relaxed">{t('anatomy.subtitle')}</p>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse text-xs font-mono">
              <thead>
                <tr class="border-b border-hairline text-mute">
                  <th class="py-2 px-3 font-semibold">Field</th>
                  <th class="py-2 px-3 font-semibold">Required</th>
                  <th class="py-2 px-3 font-semibold">Allowed Values</th>
                  <th class="py-2 px-3 font-semibold">Allowed Special Chars</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline text-body">
                <tr>
                  <td class="py-2 px-3 font-semibold text-white">Minute</td>
                  <td class="py-2 px-3 text-emerald-400">Yes</td>
                  <td class="py-2 px-3 text-link">0 - 59</td>
                  <td class="py-2 px-3 text-mute">* , - /</td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-semibold text-white">Hour</td>
                  <td class="py-2 px-3 text-emerald-400">Yes</td>
                  <td class="py-2 px-3 text-link">0 - 23</td>
                  <td class="py-2 px-3 text-mute">* , - /</td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-semibold text-white">Day of Month</td>
                  <td class="py-2 px-3 text-emerald-400">Yes</td>
                  <td class="py-2 px-3 text-link">1 - 31</td>
                  <td class="py-2 px-3 text-mute">* , - / ? L W</td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-semibold text-white">Month</td>
                  <td class="py-2 px-3 text-emerald-400">Yes</td>
                  <td class="py-2 px-3 text-link">1 - 12 or JAN-DEC</td>
                  <td class="py-2 px-3 text-mute">* , - /</td>
                </tr>
                <tr>
                  <td class="py-2 px-3 font-semibold text-white">Day of Week</td>
                  <td class="py-2 px-3 text-emerald-400">Yes</td>
                  <td class="py-2 px-3 text-link">0 - 6 or SUN-SAT</td>
                  <td class="py-2 px-3 text-mute">* , - / ? L #</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </article>

      <!-- Section: Popular Examples -->
      <section id="common-examples" class="scroll-mt-24 space-y-6">
        <div class="max-w-2xl">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            {t('examples.title')}
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">*/5 * * * *</code>
            <p class="text-xs text-white font-medium">Every 5 minutes</p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">0 * * * *</code>
            <p class="text-xs text-white font-medium">Every hour at minute 0</p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">0 0 * * *</code>
            <p class="text-xs text-white font-medium">Every day at midnight</p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">0 9 * * 1-5</code>
            <p class="text-xs text-white font-medium">At 09:00 AM, Monday through Friday</p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">0 0 1 * *</code>
            <p class="text-xs text-white font-medium">At midnight on day 1 of every month</p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-4 space-y-2">
            <code class="text-xs font-mono text-link font-bold bg-canvas px-2 py-1 rounded border border-hairline inline-block">0 0 * * 0</code>
            <p class="text-xs text-white font-medium">At midnight every Sunday</p>
          </div>
        </div>
      </section>

      <!-- Section: FAQ -->
      <section id="faq-section" class="scroll-mt-24 space-y-6">
        <div class="max-w-2xl">
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            {t('faq.title')}
          </h2>
        </div>

        <div class="space-y-4 max-w-3xl">
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-5 space-y-2">
            <h3 class="text-sm font-semibold text-white">How do I test a cron expression online?</h3>
            <p class="text-xs text-body leading-relaxed">
              Simply input your cron string into the interactive editor above. CronGen automatically parses the expression, renders a natural-language description, and calculates upcoming run execution times in real time.
            </p>
          </div>
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-5 space-y-2">
            <h3 class="text-sm font-semibold text-white">What is the difference between 5-field and 6-field cron expressions?</h3>
            <p class="text-xs text-body leading-relaxed">
              Standard Unix crontab uses 5 fields (minute, hour, day of month, month, day of week). Systems like Quartz, AWS EventBridge, and Spring use 6 or 7 fields by adding seconds or year parameters.
            </p>
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer lang={lang} />
</Layout>
