<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Reading progress bar calculation
    const progressBar = document.getElementById('reading-progress');
    const article = document.getElementById('article-content');

    window.addEventListener('scroll', () => {
      if (!progressBar || !article) return;
      const articleRect = article.getBoundingClientRect();
      const articleHeight = article.offsetHeight;
      const windowHeight = window.innerHeight;
      const scrolled = window.scrollY - article.offsetTop;
      const progress = Math.min(100, Math.max(0, (scrolled / (articleHeight - windowHeight)) * 100));
      progressBar.style.width = `${progress}%`;
    }, { passive: true });

    // Copy recipe button interaction
    const copyButtons = document.querySelectorAll('.copy-recipe-btn');
    copyButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.getAttribute('data-copy-text');
        if (text) {
          try {
            await navigator.clipboard.writeText(text);
            const originalHTML = btn.innerHTML;
            btn.innerHTML = `<svg class="w-4 h-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>`;
            setTimeout(() => {
              btn.innerHTML = originalHTML;
            }, 1800);
          } catch (e) {
            console.error('Clipboard copy failed', e);
          }
        }
      });
    });

    // Share button interaction
    const shareBtn = document.getElementById('share-article-btn');
    const shareText = document.getElementById('share-btn-text');
    if (shareBtn && shareText) {
      shareBtn.addEventListener('click', async () => {
        if (navigator.share) {
          try {
            await navigator.share({
              title: document.title,
              url: window.location.href,
            });
          } catch (e) {
            // User cancelled or share failed
          }
        } else {
          try {
            await navigator.clipboard.writeText(window.location.href);
            shareText.textContent = 'Link Copied!';
            setTimeout(() => {
              shareText.textContent = 'Share Guide';
            }, 2000);
          } catch (e) {
            console.error(e);
          }
        }
      });
    }

    // Active TOC scroll spy
    const tocLinks = document.querySelectorAll('.toc-link');
    const sections = document.querySelectorAll('section[id]');
    
    window.addEventListener('scroll', () => {
      let currentId = '';
      sections.forEach((sec) => {
        const top = sec.getBoundingClientRect().top;
        if (top <= 120) {
          currentId = sec.getAttribute('id') || '';
        }
      });

      tocLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (href === `#${currentId}`) {
          link.classList.add('text-link', 'font-bold', 'bg-link/10');
          link.classList.remove('text-body');
        } else {
          link.classList.remove('text-link', 'font-bold', 'bg-link/10');
          link.classList.add('text-body');
        }
      });
    }, { passive: true });
  });
</script>
