---
// src/pages/blog/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts, type BlogPost } from "../../data/blog";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = "en";

// Schema.org structured data for SEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.title,
  "description": post.description,
  "datePublished": "2026-10-15T09:00:00+00:00",
  "dateModified": "2026-10-15T09:00:00+00:00",
  "author": {
    "@type": "Organization",
    "name": post.author.name,
    "url": "https://crongen.dev"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CronGen",
    "url": "https://crongen.dev",
    "logo": {
      "@type": "ImageObject",
      "url": "https://crongen.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://crongen.dev/blog/${post.slug}`
  },
  "keywords": post.tags.join(", ")
};
---

<Layout 
  title={`${post.title} | CronGen`} 
  description={post.description}
  lang={lang}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-link z-50 transition-all duration-75 w-0" aria-hidden="true"></div>

  <!-- Decorative Mesh Gradient Background -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <Header lang={lang} />

  <div class="max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link rounded">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link rounded">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-white truncate max-w-[280px] sm:max-w-md" aria-current="page">{post.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="max-w-4xl mx-auto space-y-6 text-center md:text-left mb-14">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded-full bg-link/10 text-link border border-link/20 font-medium">
          {post.category}
        </span>
        <span class="text-mute tabular-nums">{post.readTime}</span>
        <span class="text-mute" aria-hidden="true">•</span>
        <time datetime="2026-10-15" class="text-mute tabular-nums">{post.publishDate}</time>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl text-balance">
        {post.subtitle}
      </p>

      <!-- Author Card & Actions -->
      <div class="pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-link to-violet-600 flex items-center justify-center text-white font-mono font-bold text-sm shadow-md">
            CG
          </div>
          <div class="text-left">
            <p class="text-xs font-semibold text-white">{post.author.name}</p>
            <p class="text-[11px] font-mono text-mute">{post.author.role}</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="share-article-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline hover:border-hairline-strong bg-canvas-soft text-xs font-mono text-body hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
          >
            <svg class="w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span id="share-btn-text">Share Guide</span>
          </button>

          <a 
            href="/" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-link hover:bg-link-deep text-white text-xs font-mono font-medium transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
          >
            <span>Open Tool</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Two-Column Layout: Sticky Sidebar (Desktop) + Main Article Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Table of Contents Sidebar -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-6" aria-label="Table of Contents">
        <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono text-white font-bold uppercase tracking-wider">
            <svg class="w-4 h-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>Table of Contents</span>
          </div>

          <nav class="space-y-1 text-xs font-mono">
            <a href="#the-problem" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">1. The Problem with Crontab</a>
            <a href="#cron-anatomy" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">2. Anatomy of 5 Fields</a>
            <a href="#special-characters" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">3. Special Characters (* , - /)</a>
            <a href="#how-to-use-crongen" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">4. How to Use CronGen</a>
            <a href="#production-recipes" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">5. 10 Production Recipes</a>
            <a href="#common-traps" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">6. 4 Dangerous Traps</a>
            <a href="#deploying-cron" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">7. Deployment Across Stacks</a>
            <a href="#faq" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">8. Frequently Asked Questions</a>
          </nav>
        </div>

        <!-- Quick Callout Card in Sidebar -->
        <div class="bg-gradient-to-b from-link/10 to-canvas-soft border border-link/20 rounded-xl p-5 space-y-3">
          <p class="text-xs font-mono font-bold text-white uppercase tracking-wider">Try it live</p>
          <p class="text-xs text-body leading-relaxed">
            Need an expression right now? Test any pattern in our visual builder.
          </p>
          <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-link hover:underline">
            Launch Generator →
          </a>
        </div>
      </aside>

      <!-- Main Article Body -->
      <article id="article-content" class="lg:col-span-9 max-w-3xl space-y-12 text-body leading-relaxed text-sm sm:text-base">

        <!-- Section 1 -->
        <section id="the-problem" class="scroll-mt-24 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            1. The Problem with Cron Syntax
          </h2>
          <p>
            Every software engineer has experienced it: you write a crontab schedule expecting a script to run once every night at 2:00 AM, only to wake up the next morning and discover your database crashed because your task ran <strong>every single minute between 2:00 AM and 2:59 AM</strong> (60 executions!).
          </p>
          <p>
            Cron syntax was designed in the late 1970s for Bell Labs Unix systems. While it has survived for over four decades due to its raw efficiency and ubiquitous adoption, its notation is notoriously cryptic, terse, and forgiving of catastrophic mistakes.
          </p>

          <!-- Callout Alert Note -->
          <div class="bg-canvas-soft border-l-4 border-link p-4 rounded-r-xl space-y-1 text-xs sm:text-sm">
            <p class="font-bold text-white font-mono uppercase text-xs flex items-center gap-1.5">
              <svg class="w-4 h-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              Why Visual Generators Matter
            </p>
            <p class="text-body">
              A modern cron expression generator bridges the cognitive gap. Instead of forcing you to mentally calculate complex ranges and modular divisions, tools like <strong>CronGen</strong> provide immediate human-readable feedback and exact simulation of the next execution timestamps.
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section id="cron-anatomy" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            2. Anatomy of a Cron Expression (The 5 Fields)
          </h2>
          <p>
            Standard POSIX/Unix crontab comprises five space-separated fields. Each position controls a specific unit of chronological time from left to right:
          </p>

          <!-- ASCII / Graphic Diagram Box -->
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-5 overflow-x-auto font-mono text-xs text-white">
            <pre class="leading-relaxed">
┌───────────── Minute (0 - 59)
│ ┌─────────── Hour (0 - 23)
│ │ ┌───────── Day of Month (1 - 31)
│ │ │ ┌─────── Month (1 - 12 or JAN - DEC)
│ │ │ │ ┌───── Day of Week (0 - 6 or SUN - SAT, 0 = Sunday)
│ │ │ │ │
* * * * *</pre>
          </div>

          <!-- Structured Comparison Table -->
          <div class="overflow-x-auto border border-hairline rounded-xl">
            <table class="w-full text-left text-xs sm:text-sm font-mono">
              <thead class="bg-canvas-soft text-white border-b border-hairline">
                <tr>
                  <th scope="col" class="py-3 px-4">Field</th>
                  <th scope="col" class="py-3 px-4">Allowed Values</th>
                  <th scope="col" class="py-3 px-4">Supported Operators</th>
                  <th scope="col" class="py-3 px-4">Aliases</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline bg-canvas-soft/40 text-body">
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">1. Minute</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 59</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">2. Hour</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 23 (24h clock)</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">3. Day of Month</td>
                  <td class="py-2.5 px-4 tabular-nums">1 – 31</td>
                  <td class="py-2.5 px-4 text-link">* , - / ? L W</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">4. Month</td>
                  <td class="py-2.5 px-4 tabular-nums">1 – 12</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-white font-medium">JAN – DEC</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">5. Day of Week</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 6 (0 = Sun)</td>
                  <td class="py-2.5 px-4 text-link">* , - / ? L #</td>
                  <td class="py-2.5 px-4 text-white font-medium">SUN – SAT</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-xs sm:text-sm">
            <span class="text-white font-semibold">Note on 6-Field Variations:</span> While standard Unix systems use 5 fields, Java frameworks (Quartz, Spring) prepend a <strong>Seconds</strong> field (<code class="text-link font-mono bg-canvas-soft px-1 rounded">0 15 10 * * ?</code>), and cloud platforms like <strong>AWS EventBridge</strong> append a <strong>Year</strong> field (<code class="text-link font-mono bg-canvas-soft px-1 rounded">0 12 * * ? *</code>).
          </p>
        </section>

        <!-- Section 3 -->
        <section id="special-characters" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            3. Demystifying Special Characters & Operators
          </h2>
          <p>
            The true expressive power of cron comes from its specialized operators. Here is how each character behaves:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            
            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-lg font-mono font-bold text-link">* (Asterisk / Wildcard)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Matches All</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Represents every possible value in that field. In the minute field, <code class="text-white font-mono">*</code> means "every minute". In the month field, it means "every month".
              </p>
              <div class="bg-canvas-soft-2 rounded p-2 text-xs font-mono text-white flex justify-between items-center">
                <span>* * * * *</span>
                <span class="text-mute text-[11px]">Every minute</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-lg font-mono font-bold text-link">, (Comma / List)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Multiple Values</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies a list of discrete values. You can execute jobs on specific minutes, specific days of the month, or specific weekdays.
              </p>
              <div class="bg-canvas-soft-2 rounded p-2 text-xs font-mono text-white flex justify-between items-center">
                <span>0 9,13,18 * * *</span>
                <span class="text-mute text-[11px]">At 9am, 1pm, 6pm</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-lg font-mono font-bold text-link">- (Hyphen / Range)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Continuous Range</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Defines an inclusive range of values. Perfect for restricting tasks to office hours or specific weekdays (Monday through Friday).
              </p>
              <div class="bg-canvas-soft-2 rounded p-2 text-xs font-mono text-white flex justify-between items-center">
                <span>0 9-17 * * 1-5</span>
                <span class="text-mute text-[11px]">Business hours</span>
              </div>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-4 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-lg font-mono font-bold text-link">/ (Slash / Step)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Interval Steps</span>
              </div>
              <p class="text-xs text-body leading-relaxed">
                Specifies rate increments. The syntax <code class="text-white font-mono">*/15</code> in minutes means "every 15 minutes starting from 0".
              </p>
              <div class="bg-canvas-soft-2 rounded p-2 text-xs font-mono text-white flex justify-between items-center">
                <span>*/15 * * * *</span>
                <span class="text-mute text-[11px]">Every 15 minutes</span>
              </div>
            </div>

          </div>
        </section>

        <!-- Section 4 -->
        <section id="how-to-use-crongen" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            4. Step-by-Step Guide: How to Use CronGen
          </h2>
          <p>
            CronGen is built specifically to turn the process of writing, parsing, and validating cron expressions into an effortless, visual workflow. Follow this tutorial to generate schedules with 100% confidence:
          </p>

          <!-- Tutorial Step Cards -->
          <div class="space-y-6">
            
            <!-- Step 1 -->
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">1</span>
                <h3 class="text-base font-bold text-white">Navigate the Visual Expression Capsules</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-9">
                At the top of the generator, you will find five interactive capsules representing <strong>Minutes</strong>, <strong>Hours</strong>, <strong>Day of Month</strong>, <strong>Month</strong>, and <strong>Day of Week</strong>. Clicking any capsule highlights it in cyan/blue, focusing the editor on that exact segment without disturbing the rest of the schedule.
              </p>
            </div>

            <!-- Step 2 -->
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">2</span>
                <h3 class="text-base font-bold text-white">Choose Quick Presets or Craft Custom Patterns</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-9">
                For routine operations (e.g. <em>Every 5 minutes</em>, <em>Hourly</em>, <em>Daily at Midnight</em>, <em>Every Sunday</em>, <em>First of the Month</em>), click the corresponding preset button for immediate population. If you need custom intervals (e.g., <code class="text-link font-mono bg-canvas-soft-2 px-1 rounded">*/20</code> or <code class="text-link font-mono bg-canvas-soft-2 px-1 rounded">2,4,6</code>), simply type directly into the focused field.
              </p>
            </div>

            <!-- Step 3 -->
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">3</span>
                <h3 class="text-base font-bold text-white">Read the Live Plain-English Translation</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-9">
                Directly underneath the expression display, CronGen integrates <code class="text-link font-mono">cronstrue</code> to translate the expression into fluent English in real time. For example, typing <code class="text-white font-mono">0 8 1,15 * 1-5</code> displays:
                <em class="block mt-2 text-link font-medium bg-canvas-soft-2 p-3 rounded border border-hairline">
                  “At 08:00 AM, on day 1 and 15 of the month, Monday through Friday”
                </em>
              </p>
            </div>

            <!-- Step 4 -->
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">4</span>
                <h3 class="text-base font-bold text-white">Inspect the Upcoming Execution Timeline</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-9">
                Before putting a script into production, scroll to the <strong>Upcoming Scheduled Runs</strong> card powered by <code class="text-link font-mono">croner</code>. It calculates the exact local and UTC dates/times for the next 5 executions along with relative countdown timers. If the first run is scheduled for a different day than you expected, you will catch it immediately.
              </p>
            </div>

            <!-- Step 5 -->
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">5</span>
                <h3 class="text-base font-bold text-white">One-Click Copy & Deployment</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-9">
                Hit the prominent <strong>Copy Cron Expression</strong> button. The validated string is copied to your operating system clipboard, ready to paste directly into your crontab, Dockerfile, or CI/CD workflow file.
              </p>
            </div>

          </div>
        </section>

        <!-- Section 5 -->
        <section id="production-recipes" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            5. 10 Production-Ready Cron Recipes
          </h2>
          <p>
            Here are ten of the most widely used cron patterns in modern backend engineering. Click any expression to copy it:
          </p>

          <div class="space-y-3">
            {[
              { label: "Every 5 minutes (Health Check / Queue Polling)", expr: "*/5 * * * *", desc: "Runs at minute 0, 5, 10, 15, 20... past every hour." },
              { label: "Every 15 minutes (Cache Invalidation)", expr: "*/15 * * * *", desc: "Runs 4 times per hour around the clock." },
              { label: "Every hour at minute 0", expr: "0 * * * *", desc: "Runs at the top of every hour (01:00, 02:00, etc.)." },
