---
// src/pages/blog/[slug].astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts, type BlogPost } from "../../data/blog";

export async function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = "en";

// Schema.org structured data for SEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": post.title,
  "description": post.description,
  "datePublished": "2026-10-15T09:00:00+00:00",
  "dateModified": "2026-10-15T09:00:00+00:00",
  "author": {
    "@type": "Organization",
    "name": post.author.name,
    "url": "https://crongen.dev"
  },
  "publisher": {
    "@type": "Organization",
    "name": "CronGen",
    "url": "https://crongen.dev",
    "logo": {
      "@type": "ImageObject",
      "url": "https://crongen.dev/favicon.svg"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://crongen.dev/blog/${post.slug}`
  },
  "keywords": post.tags.join(", ")
};
---

<Layout 
  title={`${post.title} | CronGen`} 
  description={post.description}
  lang={lang}
>
  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <!-- Reading Progress Bar -->
  <div id="reading-progress" class="fixed top-0 left-0 h-1 bg-link z-50 transition-all duration-75 w-0" aria-hidden="true"></div>

  <!-- Decorative Mesh Gradient Background -->
  <div class="mesh-gradient" aria-hidden="true"></div>

  <Header lang={lang} />

  <div class="max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8 py-10 md:py-16">
    
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-xs font-mono text-mute">
      <a href="/" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link rounded">Home</a>
      <span aria-hidden="true">/</span>
      <a href="/blog" class="hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link rounded">Blog</a>
      <span aria-hidden="true">/</span>
      <span class="text-white truncate max-w-[280px] sm:max-w-md" aria-current="page">{post.title}</span>
    </nav>

    <!-- Article Header -->
    <header class="max-w-4xl mx-auto space-y-6 text-center md:text-left mb-14">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 text-xs font-mono">
        <span class="px-2.5 py-0.5 rounded-full bg-link/10 text-link border border-link/20 font-medium">
          {post.category}
        </span>
        <span class="text-mute tabular-nums">{post.readTime}</span>
        <span class="text-mute" aria-hidden="true">•</span>
        <time datetime="2026-10-15" class="text-mute tabular-nums">{post.publishDate}</time>
        <span class="text-mute" aria-hidden="true">•</span>
        <span class="text-emerald-400 font-medium">Comprehensive Master Guide</span>
      </div>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-[1.15] text-balance">
        {post.title}
      </h1>

      <p class="text-base sm:text-lg text-body leading-relaxed max-w-3xl text-balance">
        {post.subtitle}
      </p>

      <!-- Author Card & Actions -->
      <div class="pt-6 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-link to-violet-600 flex items-center justify-center text-white font-mono font-bold text-sm shadow-md">
            CG
          </div>
          <div class="text-left">
            <p class="text-xs font-semibold text-white">{post.author.name}</p>
            <p class="text-[11px] font-mono text-mute">{post.author.role}</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="share-article-btn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-hairline hover:border-hairline-strong bg-canvas-soft text-xs font-mono text-body hover:text-white transition-colors focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
          >
            <svg class="w-3.5 h-3.5 text-mute" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
            </svg>
            <span id="share-btn-text">Share Guide</span>
          </button>

          <a 
            href="/" 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-link hover:bg-link-deep text-white text-xs font-mono font-medium transition-colors shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-link"
          >
            <span>Open Tool</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <!-- Two-Column Layout: Sticky Sidebar (Desktop) + Main Article Content -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Table of Contents Sidebar -->
      <aside class="hidden lg:block lg:col-span-3 sticky top-24 space-y-6" aria-label="Table of Contents">
        <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-3">
          <div class="flex items-center gap-2 text-xs font-mono text-white font-bold uppercase tracking-wider">
            <svg class="w-4 h-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7" />
            </svg>
            <span>Table of Contents</span>
          </div>

          <nav class="space-y-1 text-xs font-mono">
            <a href="#the-problem" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">1. The Problem with Crontab</a>
            <a href="#cron-anatomy" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">2. Anatomy of 5 & 6 Fields</a>
            <a href="#special-characters" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">3. Operators (* , - / ? L W #)</a>
            <a href="#how-to-use-crongen" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">4. How to Use CronGen</a>
            <a href="#post-mortems" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">5. Real-World Case Studies</a>
            <a href="#production-hardening" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">6. Production Hardening</a>
            <a href="#multi-stack-code" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">7. Code Implementation Guides</a>
            <a href="#preflight-checklist" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">8. Pre-Flight Checklist</a>
            <a href="#production-recipes" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">9. 12 Production Recipes</a>
            <a href="#faq" class="toc-link block py-1.5 px-2 rounded text-body hover:text-white hover:bg-canvas-soft-2 transition-colors">10. Developer FAQs</a>
          </nav>
        </div>

        <!-- Quick Callout Card in Sidebar -->
        <div class="bg-gradient-to-b from-link/10 to-canvas-soft border border-link/20 rounded-xl p-5 space-y-3">
          <p class="text-xs font-mono font-bold text-white uppercase tracking-wider">Try it live</p>
          <p class="text-xs text-body leading-relaxed">
            Need an expression right now? Test any pattern in our visual builder.
          </p>
          <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-link hover:underline">
            Launch Generator →
          </a>
        </div>
      </aside>

      <!-- Main Article Body -->
      <article id="article-content" class="lg:col-span-9 max-w-3xl space-y-14 text-body leading-relaxed text-sm sm:text-base">

        <!-- Section 1 -->
        <section id="the-problem" class="scroll-mt-24 space-y-4">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            1. The Problem with Cron Syntax & Hidden Production Costs
          </h2>
          <p>
            Every software engineer and DevOps practitioner has a war story about a background task gone wrong. You configure a scheduled backup thinking it will run once nightly at 2:00 AM, only to wake up the next morning to an alert storm: your primary database locked up because the script executed <strong>every single minute between 2:00 AM and 2:59 AM</strong> (60 overlapping executions!).
          </p>
          <p>
            Cron syntax was designed in 1979 for Version 7 Unix. While it has survived for over four decades due to its raw runtime efficiency and zero-overhead footprint, its syntax is notoriously cryptic, unforgiving of typos, and inconsistent across operating systems and cloud providers.
          </p>

          <!-- Callout Alert Note -->
          <div class="bg-canvas-soft border-l-4 border-link p-5 rounded-r-xl space-y-2 text-xs sm:text-sm">
            <p class="font-bold text-white font-mono uppercase text-xs flex items-center gap-1.5">
              <svg class="w-4 h-4 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              The High Price of Human Syntax Calculation
            </p>
            <p class="text-body leading-relaxed">
              When developers calculate cron expressions in their heads, they are forced to mentally simulate modulo divisions, non-intuitive Day-of-Month vs Day-of-Week OR logic, and zero-indexed calendar rules. Visual generators like <strong>CronGen</strong> replace guesswork with deterministic verification: offering natural-language translations (<code class="text-link font-mono">cronstrue</code>) and calculated upcoming runtime simulations (<code class="text-link font-mono">croner</code>).
            </p>
          </div>
        </section>

        <!-- Section 2 -->
        <section id="cron-anatomy" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            2. Anatomy of a Cron Expression (Standard 5-Field vs 6 & 7-Field)
          </h2>
          <p>
            Standard POSIX/Unix crontab comprises five space-separated fields. Each position controls a specific unit of chronological time evaluated from left to right:
          </p>

          <!-- Graphic Diagram Box -->
          <div class="bg-canvas-soft-2 border border-hairline rounded-xl p-5 overflow-x-auto font-mono text-xs text-white shadow-inner">
            <pre class="leading-relaxed">
┌───────────── Minute (0 - 59)
│ ┌─────────── Hour (0 - 23, 24-hour military clock)
│ │ ┌───────── Day of Month (1 - 31)
│ │ │ ┌─────── Month (1 - 12 or JAN - DEC)
│ │ │ │ ┌───── Day of Week (0 - 6 or SUN - SAT, 0 = Sunday)
│ │ │ │ │
* * * * *</pre>
          </div>

          <!-- Structured Comparison Table -->
          <div class="overflow-x-auto border border-hairline rounded-xl">
            <table class="w-full text-left text-xs sm:text-sm font-mono">
              <thead class="bg-canvas-soft text-white border-b border-hairline">
                <tr>
                  <th scope="col" class="py-3 px-4">Field</th>
                  <th scope="col" class="py-3 px-4">Allowed Range</th>
                  <th scope="col" class="py-3 px-4">Supported Operators</th>
                  <th scope="col" class="py-3 px-4">Valid Aliases</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline bg-canvas-soft/40 text-body">
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">1. Minute</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 59</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">2. Hour</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 23 (24h clock)</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">3. Day of Month</td>
                  <td class="py-2.5 px-4 tabular-nums">1 – 31</td>
                  <td class="py-2.5 px-4 text-link">* , - / ? L W</td>
                  <td class="py-2.5 px-4 text-mute">None</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">4. Month</td>
                  <td class="py-2.5 px-4 tabular-nums">1 – 12</td>
                  <td class="py-2.5 px-4 text-link">* , - /</td>
                  <td class="py-2.5 px-4 text-white font-medium">JAN – DEC</td>
                </tr>
                <tr>
                  <td class="py-2.5 px-4 font-bold text-white">5. Day of Week</td>
                  <td class="py-2.5 px-4 tabular-nums">0 – 6 (0 = Sun)</td>
                  <td class="py-2.5 px-4 text-link">* , - / ? L #</td>
                  <td class="py-2.5 px-4 text-white font-medium">SUN – SAT</td>
                </tr>
              </tbody>
            </table>
          </div>

          <div class="space-y-3 pt-2">
            <h3 class="text-base font-bold text-white">Understanding Extended 6 & 7-Field Dialects</h3>
            <p class="text-xs sm:text-sm text-body leading-relaxed">
              When working across enterprise frameworks, the 5-field Unix standard is often augmented:
            </p>
            <ul class="list-disc list-inside space-y-1.5 text-xs font-mono text-body">
              <li><strong class="text-white">Java Quartz & Spring:</strong> Prepend a <strong>Seconds</strong> field (0-59) as position 1 (<code class="text-link">0 15 10 * * ?</code>), with an optional 7th field for Year (1970–2099).</li>
              <li><strong class="text-white">AWS EventBridge:</strong> Requires 6 fields where the 6th field is <strong>Year</strong> (<code class="text-link">0 12 * * ? *</code>). AWS enforces UTC and requires the question mark (<code class="text-white">?</code>) in either Day-of-Month or Day-of-Week.</li>
              <li><strong class="text-white">Azure Functions (NCRONTAB):</strong> Uses a 6-field format with Seconds at the start (<code class="text-link">0 */5 * * * *</code>).</li>
            </ul>
          </div>
        </section>

        <!-- Section 3 -->
        <section id="special-characters" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            3. The Complete Operator Encyclopedia (* , - / ? L W #)
          </h2>
          <p>
            Cron achieves its expressive flexibility through eight distinct punctuation characters. Here is a comprehensive reference to how each operates:
          </p>

          <div class="space-y-4">
            
            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">* (Asterisk / Wildcard)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Universal</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Matches every possible value within that field. In the minute field, <code class="text-white font-mono">*</code> matches all 60 minutes. In the day-of-week field, it matches Sunday through Saturday.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">, (Comma / List Union)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Discrete Values</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Combines multiple individual values into an execution set. For example, <code class="text-white font-mono">0 9,13,18 * * *</code> fires precisely at 9:00 AM, 1:00 PM, and 6:00 PM every day.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">- (Hyphen / Inclusive Range)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Continuous Range</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Specifies a continuous, inclusive interval between a lower and upper bound. <code class="text-white font-mono">0 9-17 * * 1-5</code> runs every hour between 9 AM and 5 PM on Monday through Friday.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">/ (Slash / Step Increments)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Modulo Step</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Specifies periodic step rates within a range. <code class="text-white font-mono">*/15</code> in the minute slot runs at 0, 15, 30, and 45. You can also specify an offset start: <code class="text-white font-mono">5/10</code> runs at minutes 5, 15, 25, 35, 45, 55.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">? (Question Mark / No Specific Value)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Quartz / AWS</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Disregards a field's constraint in 6-field schedulers. Because day-of-month and day-of-week can conflict, Quartz and AWS EventBridge require placing <code class="text-white font-mono">?</code> in one of the two day fields.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">L (Last Day Indicator)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Month End</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Specifies the final day of the calendar period. In Day of Month, <code class="text-white font-mono">L</code> calculates the last day of the current month (taking leap years into account). In Day of Week, <code class="text-white font-mono">5L</code> means "the last Friday of the month".
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link">W (Nearest Weekday Modifier)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Business Logic</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Finds the closest weekday (Monday–Friday) to a given day of the month without jumping across month boundaries. For example, <code class="text-white font-mono">1W</code> triggers on Monday the 3rd if the 1st falls on a Saturday.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-5 space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-base font-mono font-bold text-link"># (N-th Occurrence of Weekday)</span>
                <span class="text-[10px] font-mono uppercase bg-canvas-soft-2 px-2 py-0.5 rounded border border-hairline">Ordinal Day</span>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed">
                Specifies the Nth occurrence of a weekday in the month. <code class="text-white font-mono">2#1</code> means the 1st Monday of the month, while <code class="text-white font-mono">5#3</code> means the 3rd Thursday of the month.
              </p>
            </div>

          </div>
        </section>

        <!-- Section 4 -->
        <section id="how-to-use-crongen" class="scroll-mt-24 space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight flex items-center gap-2 text-balance">
            <span class="w-1.5 h-6 bg-link rounded-full"></span>
            4. Step-by-Step Guide: How to Use CronGen
          </h2>
          <p>
            CronGen provides an interactive, visual playground that converts complex crontab requirements into verified, copyable schedule strings in seconds. Here is how to make the most of every feature:
          </p>

          <div class="space-y-6">
            
            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">1</span>
                <h3 class="text-base font-bold text-white">Segment Capsule Isolation</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-10">
                At the core of CronGen's visual interface are the interactive segment capsules. Clicking on <strong>Minute</strong>, <strong>Hour</strong>, <strong>Day</strong>, <strong>Month</strong>, or <strong>Weekday</strong> illuminates that segment in bright cyan/blue. This lets you inspect and modify a single temporal dimension without accidentally corrupting the rest of the schedule.
              </p>
            </div>

            <div class="bg-canvas-soft border border-hairline rounded-xl p-6 space-y-3">
              <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-full bg-link text-white font-mono text-xs font-bold flex items-center justify-center">2</span>
                <h3 class="text-base font-bold text-white">One-Click Quick Presets</h3>
              </div>
              <p class="text-xs sm:text-sm text-body leading-relaxed pl-10">
