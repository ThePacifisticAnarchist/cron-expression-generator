---
import { getLocalizedPathname, SUPPORTED_LOCALES, useTranslations, type SupportedLocale } from "../i18n/utils";

interface Props {
  lang?: SupportedLocale;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const homeUrl = getLocalizedPathname('/', lang);
const blogUrl = getLocalizedPathname('/blog', lang);
const currentPath = Astro.url.pathname;

const currentLocaleObj = SUPPORTED_LOCALES.find(l => l.code === lang) || SUPPORTED_LOCALES[0];
const isBlogActive = currentPath.includes('/blog');
---

<!-- Header Sticky Navigation -->
<header class="sticky top-0 z-40 bg-canvas/80 backdrop-blur-md border-b border-hairline transition-all duration-200">
  <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <div class="flex items-center gap-4 sm:gap-6">
      <a href={homeUrl} class="flex items-center gap-2 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link focus-visible:ring-offset-2 focus-visible:ring-offset-canvas" aria-label="CronGen Home">
        <svg class="w-6 h-6 text-white group-hover:text-link transition-colors" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="font-sans font-bold text-lg text-white tracking-tight">
          Cron<span class="text-link">Gen</span>
        </span>
      </a>

      <!-- Primary Navigation -->
      <nav class="flex items-center gap-1" aria-label="Main Navigation">
        <a 
          href={homeUrl} 
          class={`px-2.5 sm:px-3 py-1 rounded-lg text-xs font-mono transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link ${
            !isBlogActive && currentPath === homeUrl 
              ? 'text-white bg-canvas-soft border border-hairline font-semibold' 
              : 'text-body hover:text-white hover:bg-canvas-soft/60'
          }`}
        >
          Generator
        </a>
        <a 
          href={blogUrl} 
          class={`px-2.5 sm:px-3 py-1 rounded-lg text-xs font-mono transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-link ${
            isBlogActive 
              ? 'text-white bg-canvas-soft border border-hairline font-semibold' 
              : 'text-body hover:text-white hover:bg-canvas-soft/60'
          }`}
        >
          {t('nav.blog')}
        </a>
      </nav>
    </div>

    <div class="flex items-center gap-3 sm:gap-4">
      <!-- Language Switcher Dropdown -->
      <div class="relative group" id="lang-switcher">
        <button 
          type="button"
          id="lang-menu-btn"
          aria-haspopup="true"
          aria-expanded="false"
          class="flex items-center gap-2 h-8 px-3 rounded-lg border border-hairline hover:border-hairline-strong text-xs font-mono text-white bg-canvas-soft hover:bg-canvas-soft-2 transition-colors focus:outline-none focus:ring-1 focus:ring-link"
        >
          <svg class="w-3.5 h-3.5 text-link" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 014 9 15.3 15.3 0 01-4 9 15.3 15.3 0 01-4-9 15.3 15.3 0 014-9z" />
          </svg>
          <span>{currentLocaleObj.name}</span>
          <svg class="w-3 h-3 text-mute transition-transform duration-200 group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div 
          id="lang-menu-dropdown"
          class="hidden absolute right-0 mt-1 w-44 rounded-xl bg-canvas-soft-2 border border-hairline shadow-2xl py-1.5 z-50 transition-all duration-150"
          role="menu"
        >
          {SUPPORTED_LOCALES.map(loc => {
            const targetUrl = getLocalizedPathname(currentPath, loc.code);
            const isSelected = loc.code === lang;
            return (
              <a
                href={targetUrl}
                role="menuitem"
                class={`flex items-center justify-between px-3.5 py-1.5 text-xs font-mono transition-colors ${
                  isSelected 
                    ? 'text-link bg-link/10 font-bold' 
                    : 'text-body hover:text-white hover:bg-canvas-soft'
                }`}
              >
                <span>{loc.name}</span>
                {isSelected && (
                  <span class="w-1.5 h-1.5 rounded-full bg-link"></span>
                )}
              </a>
            );
          })}
        </div>
      </div>

      <span 
        class="hidden sm:inline-flex items-center justify-center h-8 px-3.5 rounded-lg border border-hairline text-xs font-mono font-semibold text-mute bg-canvas-soft-2/40 select-none"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-link animate-ping mr-2"></span>
        {t('nav.racingSoon')}
      </span>
    </div>
  </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('lang-menu-btn');
    const dropdown = document.getElementById('lang-menu-dropdown');
    const switcher = document.getElementById('lang-switcher');

    if (btn && dropdown) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        dropdown.classList.toggle('hidden');
      });

      document.addEventListener('click', (e) => {
        if (switcher && !switcher.contains(e.target as Node)) {
          dropdown.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
</script>
